APP_NAME=SetorKu
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://setorku.example.com

APP_LOCALE=id
APP_FALLBACK_LOCALE=id
APP_FAKER_LOCALE=id_ID

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

# Logging Configuration (Di Render, gunakan LOG_CHANNEL=stderr agar log tampil di dashboard)
LOG_CHANNEL=stderr
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning

# Database Configuration (MySQL / MariaDB / TiDB Cloud Starter)
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=setorku_production
DB_USERNAME=setorku_user
DB_PASSWORD=GANTI_DENGAN_PASSWORD_DATABASE_KUAT
# Opsi SSL/TLS (Wajib untuk TiDB Cloud Starter; kosongkan jika MySQL lokal tanpa SSL)
# Pada container Debian/Render gunakan: /etc/ssl/certs/ca-certificates.crt
DB_SSL_CA=

# Session Configuration
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=true
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax

# Queue & Cache
BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
CACHE_STORE=database

# Mail Configuration (Gunakan SMTP produksi seperti SES / SendGrid / Mailgun)
MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=smtp.mailgun.org
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS="no-reply@setorku.example.com"
MAIL_FROM_NAME="${APP_NAME}"

# Titik Depot Bank Sampah (Titik 0 Optimasi Rute Penjemputan — PBI-11)
BANK_SAMPAH_NAME="Bank Sampah SetorKu Yogyakarta"
BANK_SAMPAH_LAT=-7.7970680
BANK_SAMPAH_LNG=110.3705290

# Google OAuth (Wajib HTTPS di production — PBI-15)
# Daftarkan GOOGLE_REDIRECT_URI persis seperti di bawah pada Google Cloud Console
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://setorku.example.com/auth/google/callback

# Email Administrator Pertama (Wajib diisi akun Google Admin sebelum php artisan db:seed)
# Di production, akun ini dibuat tanpa password lokal dan hanya bisa login via Google OAuth.
SEED_ADMIN_EMAIL=
